# ملف نموذج للإعدادات؛ انسخ القيم المطلوبة إلى Replit Secrets عند الحاجة.
# لا تستخدم المفتاح الخاص أو بيانات الإنتاج في ملف محلي أو مستودع.
PRIVATE_KEY=
BSCSCAN_KEY=
TREASURY_ADDRESS=
PUBLISHER_ADDRESS=
BSC_TESTNET_PAYMENT_TOKEN_ADDRESS=
DEPLOY_TEST_MOCK_PAYMENT_TOKEN=false
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545/
NEXUS_PER_USDT=
PRESALE_HARD_CAP_NEXUS=10000
PRESALE_MIN_PURCHASE_USDT=
PRESALE_START_TIMESTAMP=
PRESALE_DURATION_DAYS=
SIGNAL_REGISTRY_ADDRESS=
SIGNAL_REGISTRY_DEPLOY_BLOCK=
PRESALE_ADDRESS=
SUBSCRIPTION_MANAGER_ADDRESS=

# خادم Flask؛ لا تُفعّل التداول قبل إعداد أسرار Testnet ومراجعة المخاطر.
BASE_PATH=/nexus-api
CORS_ORIGINS=
DB_NAME=nexus.db
SECRET_KEY=
ENABLE_TESTNET_TRADING=false
ENABLE_AUTO_TRADE=false
BINANCE_TESTNET=false
